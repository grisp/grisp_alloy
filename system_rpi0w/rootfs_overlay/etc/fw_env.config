# fw_printenv / fw_setenv configuration.
#
# Must match the uboot-env block in system_rpi0w/fwup_include/fwup-common.conf:
#   UBOOT_ENV_OFFSET = 16 blocks   -> 0x2000 bytes
#   UBOOT_ENV_COUNT  = 16 blocks   -> 0x2000 bytes (8 KiB)
#
# Columns: device, offset, env-size, flash-sector-size, num-sectors

# Device name	Device offset	Env size	Flash sector size	Number of sectors
/dev/mmcblk0	0x2000		0x2000		0x200			16
