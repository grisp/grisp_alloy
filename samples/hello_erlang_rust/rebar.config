{erl_opts, [debug_info]}.
{deps, []}.

{pre_hooks, [{compile, "make -C native"}]}.
{post_hooks, [{clean, "make -C native clean"}]}.

{shell, [{apps, [hello_erlang_rust]}]}.

{relx, [
    {release, {hello_erlang_rust, "0.1.0"}, [hello_erlang_rust]},
    {include_erts, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {extended_start_script, true},
    {include_src, false}
]}.
