#!/usr/bin/env bash
set -euo pipefail

usage() {
    local current_mode="${ALLOY_MODE:-repo}"
    cat <<'EOF'
Usage: alloy [GLOBAL_OPTIONS] verb [noun] [COMMAND_OPTIONS] [ARGUMENTS]

Global options:
  -h, --help                 Show help (global or command-level)
  -v, --version              Show alloy version
  -d, -dd, -ddd              Increment debug level
  -dN, --debug[=N]           Set debug level to N (non-negative integer)
      --trace                Enable bash trace mode for orchestrator scripts
      --dev                  Enable development mode
  -F, --force-vagrant        Force Vagrant execution
  -K, --keep-vagrant         Keep Vagrant VM running after completion
  -P, --provision            Force Vagrant provisioning before execution
      --init-deps            Initialize required repository dependencies on demand
      --forward-env PATTERN  Forward extra environment variable patterns
      --forward-env=PATTERN  Forward extra environment variable patterns
EOF
    echo
    echo "Commands (available in ${current_mode} mode):"
    print_commands_for_mode "${current_mode}"
}

declare -a COMMAND_MATRIX=(
    "build sdk|repo"
    "build project|repo,sdk"
    "build firmware|repo,sdk"
    "prepare sdk|sdk"
    "serve artefacts|repo,sdk"
    "grispio|repo,sdk"
)

command_allowed_in_mode() {
    local command_key="$1"
    local mode="$2"
    local entry key modes
    for entry in "${COMMAND_MATRIX[@]}"; do
        key="${entry%%|*}"
        modes="${entry#*|}"
        if [[ "${key}" == "${command_key}" ]]; then
            [[ ",${modes}," == *",${mode},"* ]]
            return
        fi
    done
    return 1
}

mode_label() {
    case "$1" in
        repo) echo "repository" ;;
        sdk) echo "sdk" ;;
        *) echo "$1" ;;
    esac
}

allowed_modes_for_command() {
    local command_key="$1"
    local entry key modes
    for entry in "${COMMAND_MATRIX[@]}"; do
        key="${entry%%|*}"
        modes="${entry#*|}"
        if [[ "${key}" == "${command_key}" ]]; then
            echo "${modes}"
            return 0
        fi
    done
    return 1
}

print_commands_for_mode() {
    local mode="$1"
    local entry key
    for entry in "${COMMAND_MATRIX[@]}"; do
        key="${entry%%|*}"
        if command_allowed_in_mode "${key}" "${mode}"; then
            echo "  ${key}"
        fi
    done
}

version() {
    echo "alloy dev"
}

GLOBAL_DEBUG=0
GLOBAL_TRACE=false
GLOBAL_DEV_MODE=false
GLOBAL_FORCE_VAGRANT=false
GLOBAL_KEEP_VAGRANT=false
GLOBAL_PROVISION=false
GLOBAL_INIT_DEPS=false
GLOBAL_HELP=false
GLOBAL_VERSION=false
declare -a GLOBAL_FORWARD_ENV_PATTERNS=()
declare -a REMAINING_ARGS=()

parse_global_options() {
    while [[ $# -gt 0 ]]; do
        local token="$1"
        shift
        case "${token}" in
            --)
                REMAINING_ARGS+=("$@")
                break
                ;;
            --debug)
                GLOBAL_DEBUG=$((GLOBAL_DEBUG + 1))
                ;;
            --debug=*)
                local value="${token#*=}"
                is_non_negative_integer "${value}" || fail "Invalid --debug value: ${value}"
                GLOBAL_DEBUG="${value}"
                ;;
            --trace)
                GLOBAL_TRACE=true
                ;;
            --dev)
                GLOBAL_DEV_MODE=true
                ;;
            --force-vagrant)
                GLOBAL_FORCE_VAGRANT=true
                ;;
            --keep-vagrant)
                GLOBAL_KEEP_VAGRANT=true
                ;;
            --provision)
                GLOBAL_PROVISION=true
                ;;
            --init-deps)
                GLOBAL_INIT_DEPS=true
                ;;
            --forward-env)
                [[ $# -gt 0 ]] || fail "--forward-env requires a value"
                GLOBAL_FORWARD_ENV_PATTERNS+=("$1")
                shift
                ;;
            --forward-env=*)
                local pattern="${token#*=}"
                [[ -n "${pattern}" ]] || fail "--forward-env requires a value"
                GLOBAL_FORWARD_ENV_PATTERNS+=("${pattern}")
                ;;
            --help)
                GLOBAL_HELP=true
                ;;
            --version)
                GLOBAL_VERSION=true
                ;;
            -h)
                GLOBAL_HELP=true
                ;;
            -v)
                GLOBAL_VERSION=true
                ;;
            -F)
                GLOBAL_FORCE_VAGRANT=true
                ;;
            -K)
                GLOBAL_KEEP_VAGRANT=true
                ;;
            -P)
                GLOBAL_PROVISION=true
                ;;
            -d[0-9]*)
                local short_value="${token#-d}"
                is_non_negative_integer "${short_value}" || fail "Invalid -d value: ${short_value}"
                GLOBAL_DEBUG="${short_value}"
                ;;
            -d*)
                if [[ "${token}" =~ ^-d+$ ]]; then
                    local count="${#token}"
                    GLOBAL_DEBUG=$((GLOBAL_DEBUG + count - 1))
                else
                    local short_flags="${token#-}"
                    local recognized=true
                    local i
                    for ((i=0; i<${#short_flags}; i++)); do
                        local ch="${short_flags:${i}:1}"
                        case "${ch}" in
                            d) GLOBAL_DEBUG=$((GLOBAL_DEBUG + 1)) ;;
                            F) GLOBAL_FORCE_VAGRANT=true ;;
                            K) GLOBAL_KEEP_VAGRANT=true ;;
                            P) GLOBAL_PROVISION=true ;;
                            h) GLOBAL_HELP=true ;;
                            v) GLOBAL_VERSION=true ;;
                            *)
                                recognized=false
                                break
                                ;;
                        esac
                    done
                    if [[ "${recognized}" == false ]]; then
                        REMAINING_ARGS+=("${token}")
                    fi
                fi
                ;;
            *)
                REMAINING_ARGS+=("${token}")
                ;;
        esac
    done
}

extract_command() {
    local first_non_option=-1
    local i
    for ((i=0; i<${#REMAINING_ARGS[@]}; i++)); do
        if [[ "${REMAINING_ARGS[$i]}" != -* ]]; then
            first_non_option="${i}"
            break
        fi
    done

    if [[ "${first_non_option}" -lt 0 ]]; then
        return 1
    fi

    if [[ "${first_non_option}" -gt 0 ]]; then
        fail "Unknown global option: ${REMAINING_ARGS[0]}"
    fi

    COMMAND_VERB="${REMAINING_ARGS[0]}"
    COMMAND_ARGS=("${REMAINING_ARGS[@]:1}")
    return 0
}

check_required_runtime_commands() {
    local -a required_commands=()
    if [[ "${GLOBAL_FORCE_VAGRANT}" == true ]] || [[ "${OSTYPE:-}" != linux* ]]; then
        required_commands+=(rsync)
    fi
    if [[ "${GLOBAL_INIT_DEPS}" == true ]]; then
        required_commands+=(git)
    fi

    if [[ ${#required_commands[@]} -eq 0 ]]; then
        return 0
    fi

    require_commands "${required_commands[@]}" || return 2
}

ALLOY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
export ALLOY_ROOT

# shellcheck source=scripts/utils/common.sh
source "${ALLOY_ROOT}/scripts/utils/common.sh"
ALLOY_ROOT="$(resolve_script_dir "${BASH_SOURCE[0]}")"
ALLOY_ROOT_DIR="${ALLOY_ROOT}"
export ALLOY_ROOT ALLOY_ROOT_DIR

if [[ -f "${ALLOY_ROOT}/ALLOY_SDK_MANIFEST" ]]; then
    ALLOY_MODE="sdk"
    ALLOY_BUILD_DIR="${HOME}/.grisp_alloy/build"
    ALLOY_ARTEFACT_DIR="${HOME}/.grisp_alloy/artefacts"
    ALLOY_CACHE_DIR="${HOME}/.grisp_alloy/cache"
else
    ALLOY_MODE="repo"
    ALLOY_BUILD_DIR="${ALLOY_ROOT}/_build"
    ALLOY_ARTEFACT_DIR="${ALLOY_ROOT}/artefacts"
    ALLOY_CACHE_DIR="${ALLOY_ROOT}/_cache"
fi

export ALLOY_MODE ALLOY_BUILD_DIR ALLOY_ARTEFACT_DIR ALLOY_CACHE_DIR

repo_declares_smelterl_submodule() {
    local gitmodules_path="${ALLOY_ROOT}/.gitmodules"
    [[ -f "${gitmodules_path}" ]] || return 1
    grep -Fq '[submodule "smelterl"]' "${gitmodules_path}" &&
        grep -Fq 'path = smelterl' "${gitmodules_path}"
}

smelterl_checkout_ready() {
    [[ -f "${ALLOY_ROOT}/smelterl/rebar.config" ]] &&
        [[ -f "${ALLOY_ROOT}/smelterl/src/smelterl.app.src" ]]
}

init_smelterl_checkout() {
    print_note "Initializing smelterl checkout via git submodule..."
    (
        cd "${ALLOY_ROOT}"
        git submodule sync --recursive smelterl
        git submodule update --init --recursive smelterl
    )
}

ensure_repo_build_sdk_dependencies() {
    [[ "${ALLOY_MODE}" == "repo" ]] || return 0
    [[ "${COMMAND_KEY:-}" == "build sdk" ]] || return 0
    [[ "${GLOBAL_HELP}" == true ]] && return 0

    if smelterl_checkout_ready; then
        return 0
    fi

    local init_hint="git submodule sync --recursive smelterl && git submodule update --init --recursive smelterl"

    if [[ "${GLOBAL_INIT_DEPS}" == true ]]; then
        if ! repo_declares_smelterl_submodule; then
            fail "smelterl checkout missing at ${ALLOY_ROOT}/smelterl and no smelterl submodule is configured"
        fi
        init_smelterl_checkout || fail "Failed to initialize smelterl checkout"
        smelterl_checkout_ready ||
            fail "smelterl checkout at ${ALLOY_ROOT}/smelterl is incomplete after initialization"
        return 0
    fi

    if repo_declares_smelterl_submodule; then
        fail "build sdk in repository mode requires smelterl checkout at ${ALLOY_ROOT}/smelterl; run '${init_hint}' or rerun with --init-deps"
    fi

    fail "build sdk in repository mode requires smelterl checkout at ${ALLOY_ROOT}/smelterl"
}

parse_global_options "$@"

if [[ "${GLOBAL_VERSION}" == true ]]; then
    version
    exit 0
fi

if ! extract_command; then
    if [[ "${GLOBAL_HELP}" == true ]]; then
        usage
        exit 0
    fi
    if [[ ${#REMAINING_ARGS[@]} -gt 0 ]] && [[ "${REMAINING_ARGS[0]}" == -* ]]; then
        fail "Unknown global option: ${REMAINING_ARGS[0]}"
    fi
    usage
    fail "No command provided"
fi

check_required_runtime_commands || exit 2

set_debug_level "${GLOBAL_DEBUG}" || fail "Invalid debug level: ${GLOBAL_DEBUG}"
if [[ "${GLOBAL_TRACE}" == true ]]; then
    set_trace true
else
    set_trace false
fi
export_boolean_env "ALLOY_DEV_MODE" "${GLOBAL_DEV_MODE}"
export_boolean_env "ALLOY_FORCE_VAGRANT" "${GLOBAL_FORCE_VAGRANT}"
export_boolean_env "ALLOY_KEEP_VAGRANT" "${GLOBAL_KEEP_VAGRANT}"
export_boolean_env "ALLOY_PROVISION" "${GLOBAL_PROVISION}"

if [[ ${#GLOBAL_FORWARD_ENV_PATTERNS[@]} -gt 0 ]]; then
    forward_env_joined="$(IFS=,; echo "${GLOBAL_FORWARD_ENV_PATTERNS[*]}")"
    if [[ -n "${ALLOY_FORWARD_ENV:-}" ]]; then
        export ALLOY_FORWARD_ENV="${ALLOY_FORWARD_ENV},${forward_env_joined}"
    else
        export ALLOY_FORWARD_ENV="${forward_env_joined}"
    fi
fi

COMMANDS_DIR="${ALLOY_COMMANDS_DIR:-${ALLOY_ROOT}/scripts/commands}"
COMMAND_SCRIPT=""
COMMAND_NOUN=""

if [[ ${#COMMAND_ARGS[@]} -gt 0 ]] && [[ "${COMMAND_ARGS[0]}" != -* ]]; then
    POSSIBLE_NOUN="${COMMAND_ARGS[0]}"
    if [[ -f "${COMMANDS_DIR}/${COMMAND_VERB}-${POSSIBLE_NOUN}.sh" ]]; then
        COMMAND_NOUN="${POSSIBLE_NOUN}"
        COMMAND_SCRIPT="${COMMANDS_DIR}/${COMMAND_VERB}-${COMMAND_NOUN}.sh"
        COMMAND_ARGS=("${COMMAND_ARGS[@]:1}")
    fi
fi

if [[ -z "${COMMAND_SCRIPT}" ]] && [[ -f "${COMMANDS_DIR}/${COMMAND_VERB}.sh" ]]; then
    COMMAND_SCRIPT="${COMMANDS_DIR}/${COMMAND_VERB}.sh"
fi

if [[ -z "${COMMAND_SCRIPT}" ]]; then
    if [[ "${GLOBAL_HELP}" == true ]]; then
        usage
        exit 0
    fi
    fail "Unknown command: ${COMMAND_VERB}${COMMAND_NOUN:+ ${COMMAND_NOUN}}"
fi

COMMAND_KEY="${COMMAND_VERB}${COMMAND_NOUN:+ ${COMMAND_NOUN}}"
if ! command_allowed_in_mode "${COMMAND_KEY}" "${ALLOY_MODE}"; then
    allowed_modes="$(allowed_modes_for_command "${COMMAND_KEY}" || true)"
    if [[ -n "${allowed_modes}" ]] && [[ "${allowed_modes}" != *","* ]]; then
        fail "${COMMAND_KEY} is only available in $(mode_label "${allowed_modes}") mode"
    fi
    fail "${COMMAND_KEY} is not available in ${ALLOY_MODE} mode"
fi

ensure_repo_build_sdk_dependencies

if [[ "${GLOBAL_HELP}" == true ]]; then
    COMMAND_ARGS=(--help "${COMMAND_ARGS[@]}")
fi

if [[ -x "${COMMAND_SCRIPT}" ]]; then
    exec "${COMMAND_SCRIPT}" "${COMMAND_ARGS[@]}"
fi
exec bash "${COMMAND_SCRIPT}" "${COMMAND_ARGS[@]}"
