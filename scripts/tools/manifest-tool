#!/usr/bin/env escript
%%! -noshell
-mode(compile).

main(Args) ->
    case Args of
        [] ->
            print_usage(standard_error),
            halt(2);
        ["--help"] ->
            print_usage(standard_io),
            halt(0);
        ["-h"] ->
            print_usage(standard_io),
            halt(0);
        ["validate-root" | RestArgs] ->
            run_validate_root(RestArgs);
        ["get" | RestArgs] ->
            run_get(RestArgs);
        ["merge" | RestArgs] ->
            run_merge(RestArgs);
        ["verify" | RestArgs] ->
            run_verify(RestArgs);
        ["hash" | RestArgs] ->
            run_hash(RestArgs);
        [Command | _] ->
            exit_with(2, "manifest-tool command not implemented yet: ~ts~n", [Command])
    end.

print_usage(Device) ->
    io:format(
        Device,
        "Usage: manifest-tool <command> [options]~n~n"
        "Commands:~n"
        "  get            Read a top-level field from any Alloy manifest.~n"
        "  merge          Merge an SDK manifest and project manifests into a firmware manifest.~n"
        "  verify         Verify the embedded integrity hash of any Alloy manifest.~n"
        "  hash           Recompute and update the integrity hash of any Alloy manifest.~n"
        "  validate-root  Validate the manifest root tuple shape and manifest type.~n~n"
        "Examples:~n"
        "  manifest-tool get --manifest ALLOY_SDK_MANIFEST --field product~n"
        "  manifest-tool merge --sdk-manifest ALLOY_SDK_MANIFEST --project-manifests 'build/projects/*/ALLOY_PROJECT_MANIFEST' --firmware-info firmware_variant=plain --output ALLOY_FIRMWARE_MANIFEST~n"
        "  manifest-tool get --manifest ALLOY_FIRMWARE_MANIFEST --field capabilities --format erlang~n"
        "  manifest-tool verify --manifest ALLOY_PROJECT_MANIFEST~n"
        "  manifest-tool hash --manifest ALLOY_PROJECT_MANIFEST~n"
        "  manifest-tool validate-root --manifest ALLOY_PROJECT_MANIFEST~n",
        []
    ).

run_validate_root(Args) ->
    case parse_validate_root_args(Args, undefined) of
        {ok, ManifestPath} ->
            case read_manifest_root(ManifestPath) of
                {ok, Tag, _Version, _Fields} ->
                    io:format("~ts~n", [atom_to_binary(Tag, utf8)]);
                {error, {structural, Reason}} ->
                    exit_with(2, "~ts~n", [format_structural_reason(Reason)]);
                {error, {parse, Reason}} ->
                    exit_with(3, "~ts~n", [format_parse_reason(ManifestPath, Reason)])
            end;
        {error, Reason} ->
            exit_with(2, "~ts~n", [Reason])
    end.

run_get(Args) ->
    case parse_get_args(Args, undefined, undefined, plain) of
        {ok, ManifestPath, FieldName, Format} ->
            case read_manifest_root(ManifestPath) of
                {ok, _Tag, _Version, Fields} ->
                    case lookup_manifest_field(FieldName, Fields) of
                        {ok, Value} ->
                            case render_field_output(Value, Format) of
                                {ok, Output} ->
                                    io:format("~ts~n", [Output]);
                                {error, Reason} ->
                                    exit_with(2, "~ts~n", [Reason])
                            end;
                        error ->
                            exit_with(1, "Field not found: ~ts~n", [FieldName])
                    end;
                {error, {structural, Reason}} ->
                    exit_with(2, "~ts~n", [format_structural_reason(Reason)]);
                {error, {parse, Reason}} ->
                    exit_with(3, "~ts~n", [format_parse_reason(ManifestPath, Reason)])
            end;
        {error, Reason} ->
            exit_with(2, "~ts~n", [Reason])
    end.

run_verify(Args) ->
    case parse_verify_args(Args, undefined, false) of
        {ok, ManifestPath, IntegrityOnly} ->
            case read_manifest_root(ManifestPath) of
                {ok, Tag, Version, Fields} ->
                    case verify_manifest(Tag, Version, Fields, IntegrityOnly) of
                        {ok, Summary} ->
                            io:format("~ts~n", [Summary]);
                        {error, {integrity, Reason}} ->
                            exit_with(1, "~ts~n", [format_verify_summary(Tag, Version, fail, Reason)]);
                        {error, {structural, Reason}} ->
                            exit_with(2, "~ts~n", [format_structural_reason(Reason)])
                    end;
                {error, {structural, Reason}} ->
                    exit_with(2, "~ts~n", [format_structural_reason(Reason)]);
                {error, {parse, Reason}} ->
                    exit_with(3, "~ts~n", [format_parse_reason(ManifestPath, Reason)])
            end;
        {error, Reason} ->
            exit_with(2, "~ts~n", [Reason])
    end.

run_hash(Args) ->
    case parse_hash_args(Args, undefined) of
        {ok, ManifestPath} ->
            case read_manifest_root(ManifestPath) of
                {ok, Tag, Version, Fields} ->
                    StrippedFields = strip_integrity_fields(Fields),
                    Digest = manifest_digest({Tag, Version, StrippedFields}),
                    UpdatedFields = append_integrity_field(StrippedFields, Digest),
                    case write_manifest(ManifestPath, {Tag, Version, UpdatedFields}) of
                        ok ->
                            ok;
                        {error, Reason} ->
                            exit_with(2, "Failed to write manifest '~ts': ~tp~n", [ManifestPath, Reason])
                    end;
                {error, {structural, Reason}} ->
                    exit_with(2, "~ts~n", [format_structural_reason(Reason)]);
                {error, {parse, Reason}} ->
                    exit_with(3, "~ts~n", [format_parse_reason(ManifestPath, Reason)])
            end;
        {error, Reason} ->
            exit_with(2, "~ts~n", [Reason])
    end.

run_merge(Args) ->
    case parse_merge_args(Args, undefined, undefined, [], undefined) of
        {ok, SdkManifestPath, ProjectManifestSpec, FirmwareInfoArgs, OutputPath} ->
            case build_firmware_manifest(SdkManifestPath, ProjectManifestSpec, FirmwareInfoArgs) of
                {ok, ManifestTerm} ->
                    case write_manifest(OutputPath, ManifestTerm) of
                        ok ->
                            ok;
                        {error, Reason} ->
                            exit_with(2, "Failed to write manifest '~ts': ~tp~n", [OutputPath, Reason])
                    end;
                {error, {Status, Message}} ->
                    exit_with(Status, "~ts~n", [Message])
            end;
        {error, Reason} ->
            exit_with(2, "~ts~n", [Reason])
    end.

parse_validate_root_args([], ManifestPath) when ManifestPath =/= undefined ->
    {ok, ManifestPath};
parse_validate_root_args([], undefined) ->
    {error, <<"validate-root requires --manifest PATH">>};
parse_validate_root_args(["--manifest", ManifestPath | RestArgs], undefined) ->
    parse_validate_root_args(RestArgs, ManifestPath);
parse_validate_root_args(["--manifest" | _], _) ->
    {error, <<"validate-root requires --manifest PATH">>};
parse_validate_root_args([Unknown | _], _) ->
    {error, iolist_to_binary(io_lib:format("validate-root: unknown argument '~ts'", [Unknown]))}.

parse_get_args([], ManifestPath, FieldName, Format)
        when ManifestPath =/= undefined, FieldName =/= undefined ->
    {ok, ManifestPath, FieldName, Format};
parse_get_args([], _ManifestPath, _FieldName, _Format) ->
    {error, <<"get requires --manifest PATH and --field FIELD_NAME">>};
parse_get_args(["--manifest", ManifestPath | RestArgs], undefined, FieldName, Format) ->
    parse_get_args(RestArgs, ManifestPath, FieldName, Format);
parse_get_args(["--field", FieldName | RestArgs], ManifestPath, undefined, Format) ->
    parse_get_args(RestArgs, ManifestPath, FieldName, Format);
parse_get_args(["--format", "erlang" | RestArgs], ManifestPath, FieldName, _Format) ->
    parse_get_args(RestArgs, ManifestPath, FieldName, erlang);
parse_get_args(["--format", "plain" | RestArgs], ManifestPath, FieldName, _Format) ->
    parse_get_args(RestArgs, ManifestPath, FieldName, plain);
parse_get_args(["--manifest" | _], _ManifestPath, _FieldName, _Format) ->
    {error, <<"get requires --manifest PATH and --field FIELD_NAME">>};
parse_get_args(["--field" | _], _ManifestPath, _FieldName, _Format) ->
    {error, <<"get requires --manifest PATH and --field FIELD_NAME">>};
parse_get_args(["--format", Format | _], _ManifestPath, _FieldName, _CurrentFormat) ->
    {error, iolist_to_binary(io_lib:format("get: unsupported format '~ts'", [Format]))};
parse_get_args([Unknown | _], _ManifestPath, _FieldName, _Format) ->
    {error, iolist_to_binary(io_lib:format("get: unknown argument '~ts'", [Unknown]))}.

parse_verify_args([], ManifestPath, IntegrityOnly) when ManifestPath =/= undefined ->
    {ok, ManifestPath, IntegrityOnly};
parse_verify_args([], undefined, _IntegrityOnly) ->
    {error, <<"verify requires --manifest PATH">>};
parse_verify_args(["--manifest", ManifestPath | RestArgs], undefined, IntegrityOnly) ->
    parse_verify_args(RestArgs, ManifestPath, IntegrityOnly);
parse_verify_args(["--integrity-only" | RestArgs], ManifestPath, _IntegrityOnly) ->
    parse_verify_args(RestArgs, ManifestPath, true);
parse_verify_args(["--manifest" | _], _ManifestPath, _IntegrityOnly) ->
    {error, <<"verify requires --manifest PATH">>};
parse_verify_args([Unknown | _], _ManifestPath, _IntegrityOnly) ->
    {error, iolist_to_binary(io_lib:format("verify: unknown argument '~ts'", [Unknown]))}.

parse_hash_args([], ManifestPath) when ManifestPath =/= undefined ->
    {ok, ManifestPath};
parse_hash_args([], undefined) ->
    {error, <<"hash requires --manifest PATH">>};
parse_hash_args(["--manifest", ManifestPath | RestArgs], undefined) ->
    parse_hash_args(RestArgs, ManifestPath);
parse_hash_args(["--manifest" | _], _) ->
    {error, <<"hash requires --manifest PATH">>};
parse_hash_args([Unknown | _], _) ->
    {error, iolist_to_binary(io_lib:format("hash: unknown argument '~ts'", [Unknown]))}.

parse_merge_args([], SdkManifestPath, ProjectManifestSpec, FirmwareInfoArgs, OutputPath)
        when SdkManifestPath =/= undefined,
             ProjectManifestSpec =/= undefined,
             OutputPath =/= undefined ->
    {ok, SdkManifestPath, ProjectManifestSpec, lists:reverse(FirmwareInfoArgs), OutputPath};
parse_merge_args([], _SdkManifestPath, _ProjectManifestSpec, _FirmwareInfoArgs, _OutputPath) ->
    {error, <<"merge requires --sdk-manifest PATH, --project-manifests GLOB, and --output PATH">>};
parse_merge_args(["--sdk-manifest", SdkManifestPath | RestArgs], undefined, ProjectManifestSpec, FirmwareInfoArgs, OutputPath) ->
    parse_merge_args(RestArgs, SdkManifestPath, ProjectManifestSpec, FirmwareInfoArgs, OutputPath);
parse_merge_args(["--project-manifests", ProjectManifestSpec | RestArgs], SdkManifestPath, undefined, FirmwareInfoArgs, OutputPath) ->
    parse_merge_args(RestArgs, SdkManifestPath, ProjectManifestSpec, FirmwareInfoArgs, OutputPath);
parse_merge_args(["--firmware-info", FirmwareInfo | RestArgs], SdkManifestPath, ProjectManifestSpec, FirmwareInfoArgs, OutputPath) ->
    parse_merge_args(RestArgs, SdkManifestPath, ProjectManifestSpec, [FirmwareInfo | FirmwareInfoArgs], OutputPath);
parse_merge_args(["--output", OutputPath | RestArgs], SdkManifestPath, ProjectManifestSpec, FirmwareInfoArgs, undefined) ->
    parse_merge_args(RestArgs, SdkManifestPath, ProjectManifestSpec, FirmwareInfoArgs, OutputPath);
parse_merge_args(["--sdk-manifest" | _], _SdkManifestPath, _ProjectManifestSpec, _FirmwareInfoArgs, _OutputPath) ->
    {error, <<"merge requires --sdk-manifest PATH, --project-manifests GLOB, and --output PATH">>};
parse_merge_args(["--project-manifests" | _], _SdkManifestPath, _ProjectManifestSpec, _FirmwareInfoArgs, _OutputPath) ->
    {error, <<"merge requires --sdk-manifest PATH, --project-manifests GLOB, and --output PATH">>};
parse_merge_args(["--firmware-info" | _], _SdkManifestPath, _ProjectManifestSpec, _FirmwareInfoArgs, _OutputPath) ->
    {error, <<"merge requires --firmware-info KEY=VALUE">>};
parse_merge_args(["--output" | _], _SdkManifestPath, _ProjectManifestSpec, _FirmwareInfoArgs, _OutputPath) ->
    {error, <<"merge requires --sdk-manifest PATH, --project-manifests GLOB, and --output PATH">>};
parse_merge_args([Unknown | _], _SdkManifestPath, _ProjectManifestSpec, _FirmwareInfoArgs, _OutputPath) ->
    {error, iolist_to_binary(io_lib:format("merge: unknown argument '~ts'", [Unknown]))}.

build_firmware_manifest(SdkManifestPath, ProjectManifestSpec, FirmwareInfoArgs) ->
    FirmwareManifestVersion = <<"1.0">>,
    maybe
        {ok, {SdkVersion, SdkFields}} ?= load_expected_manifest(
            SdkManifestPath,
            sdk_manifest,
            <<"SDK manifest">>
        ),
        {ok, ProjectManifestPaths} ?= expand_project_manifest_paths(ProjectManifestSpec),
        {ok, ProjectManifests} ?= load_project_manifests(ProjectManifestPaths),
        {ok, ok} ?= verify_input_manifest(
            SdkManifestPath,
            sdk_manifest,
            SdkVersion,
            SdkFields
        ),
        {ok, ok} ?= verify_project_manifests(ProjectManifests),
        {ok, ok} ?= validate_manifest_versions(
            FirmwareManifestVersion,
            [{SdkManifestPath, SdkVersion} | [{Path, Version} || {Path, Version, _Fields} <- ProjectManifests]]
        ),
        {ok, FirmwareInfo} ?= parse_firmware_info(FirmwareInfoArgs),
        {ok, {Repositories, RewrittenSdkFields, RewrittenProjectFields}} ?=
            consolidate_manifest_repositories(SdkFields, ProjectManifests),
        {ok, EmbeddedProjects} ?=
            embed_project_manifests(RewrittenProjectFields, maps:get(project_roots, FirmwareInfo)),
        {ok, append_integrity_to_manifest(
            firmware_manifest,
            FirmwareManifestVersion,
            build_firmware_manifest_fields(
                FirmwareInfo,
                Repositories,
                RewrittenSdkFields,
                EmbeddedProjects
            )
        )}
    end.

load_expected_manifest(ManifestPath, ExpectedTag, Label) ->
    case read_manifest_root(ManifestPath) of
        {ok, ExpectedTag, Version, Fields} ->
            {ok, {Version, Fields}};
        {ok, ActualTag, _Version, _Fields} ->
            {error,
                {2,
                    iolist_to_binary(
                        io_lib:format(
                            "~ts '~ts' must have root tag ~tp; got ~tp",
                            [Label, ManifestPath, ExpectedTag, ActualTag]
                        )
                    )}};
        {error, {structural, Reason}} ->
            {error,
                {2,
                    iolist_to_binary(
                        io_lib:format(
                            "Invalid ~ts '~ts': ~ts",
                            [Label, ManifestPath, format_structural_reason(Reason)]
                        )
                    )}};
        {error, {parse, Reason}} ->
            {error, {3, format_parse_reason(ManifestPath, Reason)}}
    end.

expand_project_manifest_paths(ProjectManifestSpec) ->
    ProjectManifestPaths0 =
        case filelib:wildcard(ProjectManifestSpec) of
            [] ->
                case filelib:is_regular(ProjectManifestSpec) of
                    true ->
                        [ProjectManifestSpec];
                    false ->
                        []
                end;
            Matches ->
                Matches
        end,
    case lists:usort(ProjectManifestPaths0) of
        [] ->
            {error,
                {2,
                    iolist_to_binary(
                        io_lib:format(
                            "merge: project manifest pattern matched no files: ~ts",
                            [ProjectManifestSpec]
                        )
                    )}};
        ProjectManifestPaths ->
            {ok, ProjectManifestPaths}
    end.

load_project_manifests(ProjectManifestPaths) ->
    load_project_manifests(ProjectManifestPaths, []).

load_project_manifests([], Acc) ->
    {ok, lists:reverse(Acc)};
load_project_manifests([ProjectManifestPath | RestPaths], Acc) ->
    case load_expected_manifest(ProjectManifestPath, project_manifest, <<"Project manifest">>) of
        {ok, {Version, Fields}} ->
            load_project_manifests(RestPaths, [{ProjectManifestPath, Version, Fields} | Acc]);
        {error, _Reason} = Error ->
            Error
    end.

verify_project_manifests([]) ->
    {ok, ok};
verify_project_manifests([{ProjectManifestPath, Version, Fields} | RestProjectManifests]) ->
    case verify_input_manifest(ProjectManifestPath, project_manifest, Version, Fields) of
        {ok, ok} ->
            verify_project_manifests(RestProjectManifests);
        {error, _Reason} = Error ->
            Error
    end.

verify_input_manifest(ManifestPath, Tag, Version, Fields) ->
    case verify_manifest(Tag, Version, Fields, false) of
        {ok, _Summary} ->
            {ok, ok};
        {error, {integrity, Reason}} ->
            {error,
                {1,
                    iolist_to_binary(
                        io_lib:format(
                            "Manifest integrity verification failed for '~ts': ~ts",
                            [ManifestPath, format_integrity_reason(Reason)]
                        )
                    )}};
        {error, {structural, Reason}} ->
            {error,
                {2,
                    iolist_to_binary(
                        io_lib:format(
                            "Invalid manifest integrity metadata in '~ts': ~ts",
                            [ManifestPath, format_structural_reason(Reason)]
                        )
                    )}}
    end.

validate_manifest_versions(FirmwareManifestVersion, SourceVersions) ->
    Offenders =
        [{ManifestPath, Version} ||
            {ManifestPath, Version} <- SourceVersions,
            not manifest_versions_compatible(Version, FirmwareManifestVersion)],
    case Offenders of
        [] ->
            {ok, ok};
        _ ->
            {error,
                {2,
                    iolist_to_binary(
                        io_lib:format(
                            "Manifest version incompatibility with firmware manifest version ~ts: ~ts",
                            [
                                FirmwareManifestVersion,
                                string:join(
                                    [
                                        binary_to_list(
                                            iolist_to_binary(
                                                io_lib:format("~ts (~ts)", [ManifestPath, Version])
                                            )
                                        )
                                     || {ManifestPath, Version} <- Offenders
                                    ],
                                    ", "
                                )
                            ]
                        )
                    )}}
    end.

manifest_versions_compatible(SourceVersion, FirmwareManifestVersion) ->
    manifest_version_major(SourceVersion) =:= manifest_version_major(FirmwareManifestVersion).

manifest_version_major(Version) when is_binary(Version) ->
    case split_binary_once(Version, <<".">>) of
        [Major, _Rest] ->
            Major;
        error ->
            Version;
        [Major] ->
            Major
    end.

parse_firmware_info(FirmwareInfoArgs) ->
    parse_firmware_info(
        FirmwareInfoArgs,
        #{
            firmware_name => undefined,
            firmware_version => undefined,
            firmware_variant => undefined,
            security_pack => [],
            parameters => [],
            project_roots => #{}
        }
    ).

parse_firmware_info([], FirmwareInfo) ->
    case maps:get(firmware_variant, FirmwareInfo) of
        undefined ->
            {error, {2, <<"merge requires --firmware-info firmware_variant=VALUE">>}};
        _FirmwareVariant ->
            {ok, FirmwareInfo}
    end;
parse_firmware_info([FirmwareInfoArg | RestArgs], FirmwareInfo0) ->
    maybe
        [Key, Value] ?= split_key_value(FirmwareInfoArg),
        {ok, FirmwareInfo} ?= parse_firmware_info_entry(Key, Value, FirmwareInfo0),
        parse_firmware_info(RestArgs, FirmwareInfo)
    else
        error ->
            {error,
                {2,
                    iolist_to_binary(
                        io_lib:format("merge: firmware-info requires KEY=VALUE; got '~ts'", [FirmwareInfoArg])
                    )}};
        {error, _Reason} = Error ->
            Error
    end.

parse_firmware_info_entry(<<"firmware_name">>, Value, FirmwareInfo) ->
    {ok, FirmwareInfo#{firmware_name => Value}};
parse_firmware_info_entry(<<"firmware_version">>, Value, FirmwareInfo) ->
    {ok, FirmwareInfo#{firmware_version => Value}};
parse_firmware_info_entry(<<"firmware_variant">>, Value, FirmwareInfo) ->
    case parse_identifier_atom(Value, <<"firmware variant">>) of
        {ok, FirmwareVariant} ->
            {ok, FirmwareInfo#{firmware_variant => FirmwareVariant}};
        {error, _Reason} = Error ->
            Error
    end;
parse_firmware_info_entry(<<"security_pack_", Key/binary>>, Value, FirmwareInfo) when Key =/= <<>> ->
    SecurityPackInfo = maps:get(security_pack, FirmwareInfo),
    {ok, FirmwareInfo#{security_pack => SecurityPackInfo ++ [{Key, Value}]}};
parse_firmware_info_entry(<<"project_root_", ProjectIdBinary/binary>>, Value, FirmwareInfo) when ProjectIdBinary =/= <<>> ->
    case parse_identifier_atom(ProjectIdBinary, <<"project id">>) of
        {ok, ProjectId} ->
            case Value of
                <<"/", _/binary>> ->
                    {ok, FirmwareInfo#{project_roots => maps:put(ProjectId, Value, maps:get(project_roots, FirmwareInfo))}};
                _ ->
                    {error,
                        {2,
                            iolist_to_binary(
                                io_lib:format(
                                    "merge: project_root_~ts must be an absolute path",
                                    [ProjectIdBinary]
                                )
                            )}}
            end;
        {error, _Reason} = Error ->
            Error
    end;
parse_firmware_info_entry(<<"param_", ParamSpec/binary>>, Value, FirmwareInfo) when ParamSpec =/= <<>> ->
    case parse_parameter_spec(ParamSpec, Value) of
        {ok, ParameterEntry} ->
            Parameters = maps:get(parameters, FirmwareInfo),
            {ok, FirmwareInfo#{parameters => Parameters ++ [ParameterEntry]}};
        {error, _Reason} = Error ->
            Error
    end;
parse_firmware_info_entry(Key, _Value, _FirmwareInfo) ->
    {error,
        {2,
            iolist_to_binary(
                io_lib:format("merge: unsupported firmware-info key '~ts'", [Key])
            )}}.

split_key_value(Value) ->
    split_binary_once(unicode:characters_to_binary(Value), <<"=">>).

parse_identifier_atom(Value, Label) ->
    case re:run(Value, <<"^[a-z][a-z0-9_]*$">>, [{capture, none}]) of
        match ->
            {ok, binary_to_atom(Value, utf8)};
        nomatch ->
            {error,
                {2,
                    iolist_to_binary(
                        io_lib:format("merge: invalid ~ts '~ts'", [Label, Value])
                    )}}
    end.

parse_parameter_spec(ParamSpec, Value) ->
    maybe
        [ParamNameBinary, TypeBinary] ?= split_binary_once(ParamSpec, <<":">>),
        true ?= byte_size(ParamNameBinary) > 0 andalso byte_size(TypeBinary) > 0,
        {ok, ParamName} ?= parse_identifier_atom(ParamNameBinary, <<"parameter name">>),
        {ok, ParamValue} ?= parse_parameter_value(TypeBinary, Value),
        {ok, {ParamName, ParamValue}}
    else
        error ->
            {error,
                {2,
                    iolist_to_binary(
                        io_lib:format(
                            "merge: invalid parameter specification 'param_~ts'",
                            [ParamSpec]
                        )
                    )}};
        false ->
            {error,
                {2,
                    iolist_to_binary(
                        io_lib:format(
                            "merge: invalid parameter specification 'param_~ts'",
                            [ParamSpec]
                        )
                    )}};
        {error, _Reason} = Error ->
            Error
    end.

parse_parameter_value(<<"string">>, Value) ->
    {ok, Value};
parse_parameter_value(<<"integer">>, Value) ->
    try
        {ok, binary_to_integer(Value)}
    catch
        error:badarg ->
            {error,
                {2,
                    iolist_to_binary(
                        io_lib:format("merge: invalid integer parameter value '~ts'", [Value])
                    )}}
    end;
parse_parameter_value(<<"boolean">>, <<"true">>) ->
    {ok, true};
parse_parameter_value(<<"boolean">>, <<"false">>) ->
    {ok, false};
parse_parameter_value(<<"boolean">>, Value) ->
    {error,
        {2,
            iolist_to_binary(
                io_lib:format("merge: invalid boolean parameter value '~ts'", [Value])
            )}};
parse_parameter_value(Type, _Value) ->
    {error,
        {2,
            iolist_to_binary(
                io_lib:format("merge: unsupported parameter type '~ts'", [Type])
            )}}.

consolidate_manifest_repositories(SdkFields, ProjectManifests) ->
    maybe
        {ok, {RepositoryState1, SdkRepositoryMap}} ?=
            register_manifest_repositories(SdkFields, new_repository_state(), <<"SDK manifest">>),
        RewrittenSdkFields =
            rewrite_repository_references(
                strip_manifest_fields(SdkFields, [integrity, repositories]),
                SdkRepositoryMap
            ),
        {ok, {RepositoryState2, RewrittenProjects}} ?=
            rewrite_project_manifests(ProjectManifests, RepositoryState1, []),
        {ok, {repository_state_entries(RepositoryState2), RewrittenSdkFields, RewrittenProjects}}
    end.

rewrite_project_manifests([], RepositoryState, Acc) ->
    {ok, {RepositoryState, lists:reverse(Acc)}};
rewrite_project_manifests([{ProjectManifestPath, _Version, ProjectFields} | RestProjectManifests], RepositoryState0, Acc) ->
    maybe
        {ok, {RepositoryState, ProjectRepositoryMap}} ?=
            register_manifest_repositories(
                ProjectFields,
                RepositoryState0,
                iolist_to_binary(io_lib:format("Project manifest '~ts'", [ProjectManifestPath]))
            ),
        RewrittenProjectFields =
            rewrite_repository_references(
                strip_manifest_fields(ProjectFields, [integrity, repositories]),
                ProjectRepositoryMap
            ),
        rewrite_project_manifests(
            RestProjectManifests,
            RepositoryState,
            [{ProjectManifestPath, RewrittenProjectFields} | Acc]
        )
    end.

new_repository_state() ->
    #{entries => [], url_map => #{}, used_ids => #{}}.

repository_state_entries(RepositoryState) ->
    maps:get(entries, RepositoryState).

register_manifest_repositories(Fields, RepositoryState, SourceLabel) ->
    case lookup_repositories_section(Fields) of
        {ok, RepositoryEntries} ->
            register_repository_entries(RepositoryEntries, RepositoryState, #{}, SourceLabel);
        {error, _Reason} = Error ->
            Error
    end.

lookup_repositories_section(Fields) ->
    case lookup_field_occurrences(repositories, Fields) of
        [] ->
            {ok, []};
        [{repositories, RepositoryEntries}] when is_list(RepositoryEntries) ->
            {ok, RepositoryEntries};
        [{repositories, _RepositoryEntries}] ->
            {error, {2, <<"Manifest repositories section must be a list">>}};
        [_First, _Second | _Rest] ->
            {error, {2, <<"Manifest must contain at most one repositories section">>}}
    end.

register_repository_entries([], RepositoryState, RepositoryMap, _SourceLabel) ->
    {ok, {RepositoryState, RepositoryMap}};
register_repository_entries([{RepoId, RepoFields} | RestEntries], RepositoryState0, RepositoryMap0, SourceLabel)
        when is_atom(RepoId), is_list(RepoFields) ->
    case lookup_field(url, RepoFields) of
        {ok, Url} when is_binary(Url) ->
            {RepositoryState, NewRepoId} = register_repository_entry(RepoId, Url, RepoFields, RepositoryState0),
            register_repository_entries(RestEntries, RepositoryState, maps:put(RepoId, NewRepoId, RepositoryMap0), SourceLabel);
        {ok, _Url} ->
            {error,
                {2,
                    iolist_to_binary(
                        io_lib:format("~ts repository ~tp has a non-binary url field", [SourceLabel, RepoId])
                    )}};
        error ->
            {error,
                {2,
                    iolist_to_binary(
                        io_lib:format("~ts repository ~tp is missing a url field", [SourceLabel, RepoId])
                    )}}
    end;
register_repository_entries([RepositoryEntry | _RestEntries], _RepositoryState, _RepositoryMap, SourceLabel) ->
    {error,
        {2,
            iolist_to_binary(
                io_lib:format("~ts has an invalid repository entry: ~0tp", [SourceLabel, RepositoryEntry])
            )}}.

register_repository_entry(RepoId, Url, RepoFields, RepositoryState0) ->
    UrlMap = maps:get(url_map, RepositoryState0),
    UsedIds = maps:get(used_ids, RepositoryState0),
    Entries = maps:get(entries, RepositoryState0),
    case maps:get(Url, UrlMap, undefined) of
        undefined ->
            NewRepoId = unique_repository_id(RepoId, UsedIds),
            {RepositoryState0#{
                entries => Entries ++ [{NewRepoId, RepoFields}],
                url_map => maps:put(Url, NewRepoId, UrlMap),
                used_ids => maps:put(NewRepoId, true, UsedIds)
            }, NewRepoId};
        ExistingRepoId ->
            {RepositoryState0, ExistingRepoId}
    end.

unique_repository_id(RepoId, UsedIds) ->
    case maps:is_key(RepoId, UsedIds) of
        false ->
            RepoId;
        true ->
            unique_repository_id(RepoId, UsedIds, 2)
    end.

unique_repository_id(RepoId, UsedIds, Suffix) ->
    CandidateRepoId =
        binary_to_atom(
            iolist_to_binary(io_lib:format("~ts~B", [atom_to_binary(RepoId, utf8), Suffix])),
            utf8
        ),
    case maps:is_key(CandidateRepoId, UsedIds) of
        false ->
            CandidateRepoId;
        true ->
            unique_repository_id(RepoId, UsedIds, Suffix + 1)
    end.

strip_manifest_fields(Fields, Keys) ->
    [Field || {Key, _Value} = Field <- Fields, not lists:member(Key, Keys)].

rewrite_repository_references(Value, RepositoryMap) when is_list(Value) ->
    [rewrite_repository_references(Item, RepositoryMap) || Item <- Value];
rewrite_repository_references({repository, RepoId}, RepositoryMap) when is_atom(RepoId) ->
    {repository, maps:get(RepoId, RepositoryMap, RepoId)};
rewrite_repository_references({smelterl_repository, RepoId}, RepositoryMap) when is_atom(RepoId) ->
    {smelterl_repository, maps:get(RepoId, RepositoryMap, RepoId)};
rewrite_repository_references(Tuple, RepositoryMap) when is_tuple(Tuple) ->
    list_to_tuple(
        [rewrite_repository_references(Item, RepositoryMap) || Item <- tuple_to_list(Tuple)]
    );
rewrite_repository_references(Value, _RepositoryMap) ->
    Value.

embed_project_manifests(ProjectFieldsList, ProjectRoots) ->
    embed_project_manifests(ProjectFieldsList, ProjectRoots, #{}, []).

embed_project_manifests([], _ProjectRoots, _SeenProjectIds, Acc) ->
    {ok, lists:reverse(Acc)};
embed_project_manifests([{ProjectManifestPath, ProjectFields} | RestProjectFields], ProjectRoots, SeenProjectIds, Acc) ->
    case lookup_field(id, ProjectFields) of
        {ok, ProjectId} when is_atom(ProjectId) ->
            case maps:is_key(ProjectId, SeenProjectIds) of
                true ->
                    {error,
                        {2,
                            iolist_to_binary(
                                io_lib:format("merge: duplicate project id '~ts'", [atom_to_binary(ProjectId, utf8)])
                            )}};
                false ->
                    case maps:get(ProjectId, ProjectRoots, undefined) of
                        undefined ->
                            {error,
                                {2,
                                    iolist_to_binary(
                                        io_lib:format(
                                            "merge: missing --firmware-info project_root_~ts=PATH for project manifest '~ts'",
                                            [atom_to_binary(ProjectId, utf8), ProjectManifestPath]
                                        )
                                    )}};
                        ProjectRoot ->
                            embed_project_manifests(
                                RestProjectFields,
                                ProjectRoots,
                                maps:put(ProjectId, true, SeenProjectIds),
                                [ProjectFields ++ [{project_root, ProjectRoot}] | Acc]
                            )
                    end
            end;
        {ok, _ProjectId} ->
            {error,
                {2,
                    iolist_to_binary(
                        io_lib:format("Project manifest '~ts' has a non-atom id field", [ProjectManifestPath])
                    )}};
        error ->
            {error,
                {2,
                    iolist_to_binary(
                        io_lib:format("Project manifest '~ts' is missing required id field", [ProjectManifestPath])
                    )}}
    end.

build_firmware_manifest_fields(FirmwareInfo, Repositories, SdkFields, EmbeddedProjects) ->
    FirmwareName = resolve_firmware_name(FirmwareInfo, SdkFields, EmbeddedProjects),
    FirmwareVersion = resolve_firmware_version(FirmwareInfo, SdkFields),
    SecurityPackField =
        case maps:get(security_pack, FirmwareInfo) of
            [] ->
                {security_pack, none};
            SecurityPackInfo ->
                {security_pack, SecurityPackInfo}
        end,
    ParameterFields =
        case maps:get(parameters, FirmwareInfo) of
            [] ->
                [];
            Parameters ->
                [{parameters, Parameters}]
        end,
    [
        {build_date, current_utc_timestamp()},
        {firmware_name, FirmwareName},
        {firmware_version, FirmwareVersion},
        {firmware_variant, maps:get(firmware_variant, FirmwareInfo)},
        SecurityPackField
    ] ++
        ParameterFields ++
        [
            {repositories, Repositories},
            {sdk, SdkFields},
            {projects, EmbeddedProjects}
        ].

resolve_firmware_name(FirmwareInfo, SdkFields, EmbeddedProjects) ->
    case maps:get(firmware_name, FirmwareInfo) of
        undefined ->
            ProjectSegments =
                [
                    iolist_to_binary([lookup_binary_field(name, ProjectFields), <<"-">>, lookup_binary_field(version, ProjectFields)])
                 || ProjectFields <- EmbeddedProjects
                ],
            JoinedProjectSegments =
                case ProjectSegments of
                    [] ->
                        <<"firmware">>;
                    _ ->
                        iolist_to_binary(string:join([binary_to_list(Segment) || Segment <- ProjectSegments], "+"))
                end,
            iolist_to_binary(
                [
                    <<"firmware-">>,
                    JoinedProjectSegments,
                    <<"-">>,
                    lookup_binary_field(product, SdkFields),
                    <<"-">>,
                    lookup_binary_field(product_version, SdkFields)
                ]
            );
        FirmwareName ->
            FirmwareName
    end.

resolve_firmware_version(FirmwareInfo, SdkFields) ->
    case maps:get(firmware_version, FirmwareInfo) of
        undefined ->
            lookup_binary_field(product_version, SdkFields);
        FirmwareVersion ->
            FirmwareVersion
    end.

lookup_binary_field(Key, Fields) ->
    case lookup_field(Key, Fields) of
        {ok, Value} when is_binary(Value) ->
            Value;
        {ok, Value} ->
            iolist_to_binary(io_lib:format("~0tp", [Value]));
        error ->
            <<"unknown">>
    end.

current_utc_timestamp() ->
    unicode:characters_to_binary(
        calendar:system_time_to_rfc3339(erlang:system_time(second), [{offset, "Z"}, {unit, second}])
    ).

append_integrity_to_manifest(Tag, Version, Fields) ->
    Digest = manifest_digest({Tag, Version, Fields}),
    {Tag, Version, append_integrity_field(Fields, Digest)}.

read_manifest_root(ManifestPath) ->
    case file:consult(ManifestPath) of
        {ok, [Term]} ->
            validate_manifest_root(Term);
        {ok, []} ->
            {error, {parse, empty_manifest}};
        {ok, _Terms} ->
            {error, {parse, multiple_terms}};
        {error, Reason} ->
            {error, {parse, Reason}}
    end.

validate_manifest_root({Tag, Version, Fields})
        when is_atom(Tag), is_binary(Version), is_list(Fields) ->
    case lists:member(Tag, [sdk_manifest, project_manifest, firmware_manifest]) of
        false ->
            {error, {structural, {unsupported_manifest_tag, Tag}}};
        true ->
            case lists:all(fun erlang:is_tuple/1, Fields) of
                true ->
                    {ok, Tag, Version, Fields};
                false ->
                    {error, {structural, manifest_fields_must_be_tuples}}
            end
    end;
validate_manifest_root({_Tag, Version, _Fields}) when not is_binary(Version) ->
    {error, {structural, manifest_version_must_be_binary}};
validate_manifest_root({_Tag, _Version, Fields}) when not is_list(Fields) ->
    {error, {structural, manifest_fields_must_be_list}};
validate_manifest_root(_Term) ->
    {error, {structural, invalid_manifest_root}}.

lookup_manifest_field(FieldName, Fields) ->
    FieldBinary = unicode:characters_to_binary(FieldName),
    lookup_manifest_field(FieldBinary, Fields, error).

lookup_manifest_field(_FieldName, [], Result) ->
    Result;
lookup_manifest_field(FieldName, [{Key, Value} | Rest], _Result)
        when is_atom(Key) ->
    case atom_to_binary(Key, utf8) of
        FieldName ->
            {ok, Value};
        _Other ->
            lookup_manifest_field(FieldName, Rest, error)
    end;
lookup_manifest_field(FieldName, [_Other | Rest], Result) ->
    lookup_manifest_field(FieldName, Rest, Result).

render_field_output(Value, erlang) ->
    {ok, iolist_to_binary(io_lib:format("~0tp", [Value]))};
render_field_output(Value, plain) when is_binary(Value) ->
    {ok, Value};
render_field_output(Value, plain) when is_atom(Value) ->
    {ok, atom_to_binary(Value, utf8)};
render_field_output(Value, plain) when is_integer(Value) ->
    {ok, integer_to_binary(Value)};
render_field_output(Value, plain) when is_list(Value) ->
    case lists:all(fun erlang:is_atom/1, Value) of
        true ->
            {ok,
                list_to_binary(
                    string:join(
                        [binary_to_list(atom_to_binary(Item, utf8)) || Item <- Value],
                        " "
                    )
                )};
        false ->
            {error, <<"Plain output does not support nested lists or proplists; use --format erlang">>}
    end;
render_field_output(_Value, plain) ->
    {error, <<"Plain output supports only binaries, atoms, integers, and lists of atoms; use --format erlang">>}.

format_structural_reason({unsupported_manifest_tag, Tag}) ->
    iolist_to_binary(
        io_lib:format(
            "Manifest root must use one of sdk_manifest, project_manifest, or firmware_manifest; got ~tp",
            [Tag]
        )
    );
format_structural_reason(manifest_version_must_be_binary) ->
    <<"Manifest root version must be a binary">>;
format_structural_reason(manifest_fields_must_be_list) ->
    <<"Manifest root fields must be a list">>;
format_structural_reason(manifest_fields_must_be_tuples) ->
    <<"Manifest root fields must contain only tuples">>;
format_structural_reason(multiple_integrity_sections) ->
    <<"Manifest must contain exactly one integrity section">>;
format_structural_reason(missing_integrity_section) ->
    <<"Manifest is missing integrity section">>;
format_structural_reason(integrity_fields_must_be_list) ->
    <<"Integrity section fields must be a list">>;
format_structural_reason(integrity_fields_must_be_tuples) ->
    <<"Integrity section fields must contain only tuples">>;
format_structural_reason({missing_integrity_field, Key}) ->
    iolist_to_binary(io_lib:format("Integrity section is missing required field: ~ts", [atom_to_binary(Key, utf8)]));
format_structural_reason({integrity_field_must_be_atom, Key}) ->
    iolist_to_binary(io_lib:format("Integrity field ~ts must be an atom", [atom_to_binary(Key, utf8)]));
format_structural_reason({integrity_field_must_be_binary, Key}) ->
    iolist_to_binary(io_lib:format("Integrity field ~ts must be a binary", [atom_to_binary(Key, utf8)]));
format_structural_reason({unsupported_digest_algorithm, Algorithm}) ->
    iolist_to_binary(io_lib:format("Unsupported digest algorithm: ~tp", [Algorithm]));
format_structural_reason({unsupported_canonical_form, Form}) ->
    iolist_to_binary(io_lib:format("Unsupported canonical form: ~tp", [Form]));
format_structural_reason({invalid_digest_format, sha256}) ->
    <<"Integrity digest must be a lowercase hex binary of length 64 for sha256">>;
format_structural_reason(invalid_manifest_root) ->
    <<"Manifest root must be {Tag, Version, Fields}">>.

format_parse_reason(ManifestPath, empty_manifest) ->
    iolist_to_binary(io_lib:format("Failed to parse manifest '~ts': file is empty", [ManifestPath]));
format_parse_reason(ManifestPath, multiple_terms) ->
    iolist_to_binary(
        io_lib:format("Failed to parse manifest '~ts': expected exactly one Erlang term", [ManifestPath])
    );
format_parse_reason(ManifestPath, Reason) ->
    iolist_to_binary(
        io_lib:format("Failed to parse manifest '~ts': ~tp", [ManifestPath, Reason])
    ).

strip_integrity_fields(Fields) ->
    [Field || {Key, _Value} = Field <- Fields, Key =/= integrity].

append_integrity_field(Fields, Digest) ->
    Fields ++
        [{integrity,
            [
                {digest_algorithm, sha256},
                {canonical_form, basic_term_canon},
                {digest, Digest}
            ]}].

verify_manifest(Tag, Version, Fields, _IntegrityOnly) ->
    case verify_integrity_metadata(Fields) of
        {ok, DigestAlgorithm, CanonicalForm, ExpectedDigest} ->
            case manifest_digest({Tag, Version, strip_integrity_fields(Fields)}, DigestAlgorithm, CanonicalForm) of
                {ok, ExpectedDigest} ->
                    {ok, format_verify_summary(Tag, Version, pass, undefined)};
                {ok, ActualDigest} ->
                    {error, {integrity, {digest_mismatch, ExpectedDigest, ActualDigest}}}
            end;
        {error, _} = Error ->
            Error
    end.

verify_integrity_metadata(Fields) ->
    case lookup_field_occurrences(integrity, Fields) of
        [] ->
            {error, {structural, missing_integrity_section}};
        [_First, _Second | _Rest] ->
            {error, {structural, multiple_integrity_sections}};
        [{integrity, IntegrityFields}] when not is_list(IntegrityFields) ->
            {error, {structural, integrity_fields_must_be_list}};
        [{integrity, IntegrityFields}] ->
            case lists:all(fun erlang:is_tuple/1, IntegrityFields) of
                false ->
                    {error, {structural, integrity_fields_must_be_tuples}};
                true ->
                    verify_integrity_fields(IntegrityFields)
            end
    end.

verify_integrity_fields(IntegrityFields) ->
    with_required_integrity_field(digest_algorithm, IntegrityFields,
        fun(DigestAlgorithm) when not is_atom(DigestAlgorithm) ->
                {error, {structural, {integrity_field_must_be_atom, digest_algorithm}}};
           (DigestAlgorithm) ->
                case DigestAlgorithm of
                    sha256 ->
                        with_required_integrity_field(canonical_form, IntegrityFields,
                            fun(CanonicalForm) when not is_atom(CanonicalForm) ->
                                    {error, {structural, {integrity_field_must_be_atom, canonical_form}}};
                               (CanonicalForm) ->
                                    case CanonicalForm of
                                        basic_term_canon ->
                                            with_required_integrity_field(digest, IntegrityFields,
                                                fun(Digest) when not is_binary(Digest) ->
                                                        {error, {structural, {integrity_field_must_be_binary, digest}}};
                                                   (Digest) ->
                                                        validate_integrity_digest(DigestAlgorithm, Digest, CanonicalForm)
                                                end);
                                        _ ->
                                            {error, {structural, {unsupported_canonical_form, CanonicalForm}}}
                                    end
                            end);
                    _ ->
                        {error, {structural, {unsupported_digest_algorithm, DigestAlgorithm}}}
                end
        end).

with_required_integrity_field(Key, IntegrityFields, Fun) ->
    case lookup_field(Key, IntegrityFields) of
        error ->
            {error, {structural, {missing_integrity_field, Key}}};
        {ok, Value} ->
            Fun(Value)
    end.

split_binary_once(Binary, Separator) ->
    case binary:match(Binary, Separator) of
        {Position, SeparatorLength} when Position > 0 ->
            [
                binary:part(Binary, 0, Position),
                binary:part(
                    Binary,
                    Position + SeparatorLength,
                    byte_size(Binary) - Position - SeparatorLength
                )
            ];
        nomatch ->
            error;
        _ ->
            error
    end.

validate_integrity_digest(sha256, Digest, CanonicalForm)
        when is_binary(Digest) ->
    case re:run(Digest, <<"^[0-9a-f]{64}$">>, [{capture, none}]) of
        match ->
            {ok, sha256, CanonicalForm, Digest};
        nomatch ->
            {error, {structural, {invalid_digest_format, sha256}}}
    end.

lookup_field(Key, Fields) ->
    lookup_field(Key, Fields, error).

lookup_field(_Key, [], Result) ->
    Result;
lookup_field(Key, [{Key, Value} | _Rest], _Result) ->
    {ok, Value};
lookup_field(Key, [_Other | Rest], Result) ->
    lookup_field(Key, Rest, Result).

lookup_field_occurrences(Key, Fields) ->
    [{FieldKey, Value} || {FieldKey, Value} <- Fields, FieldKey =:= Key].

format_verify_summary(Tag, Version, Status, undefined) ->
    iolist_to_binary(
        io_lib:format(
            "manifest=~ts version=~ts integrity=~ts",
            [atom_to_binary(Tag, utf8), Version, integrity_status_label(Status)]
        )
    );
format_verify_summary(Tag, Version, Status, Reason) ->
    iolist_to_binary(
        io_lib:format(
            "manifest=~ts version=~ts integrity=~ts reason=~ts",
            [atom_to_binary(Tag, utf8), Version, integrity_status_label(Status), format_integrity_reason(Reason)]
        )
    ).

integrity_status_label(pass) ->
    <<"PASS">>;
integrity_status_label(fail) ->
    <<"FAIL">>.

format_integrity_reason({digest_mismatch, _ExpectedDigest, _ActualDigest}) ->
    <<"Digest mismatch">>.

manifest_digest(Term) ->
    case manifest_digest(Term, sha256, basic_term_canon) of
        {ok, Digest} ->
            Digest
    end.

manifest_digest(Term, sha256, basic_term_canon) ->
    {ok, hex_encode(crypto:hash(sha256, canonical_manifest_binary(Term))) }.

canonical_manifest_binary(Term) ->
    unicode:characters_to_binary(io_lib:format("~0tp.~n", [Term])).

write_manifest(ManifestPath, Term) ->
    case filelib:ensure_dir(ManifestPath) of
        ok ->
            file:write_file(ManifestPath, render_manifest_file(Term));
        {error, Reason} ->
            {error, Reason}
    end.

render_manifest_file(Term) ->
    unicode:characters_to_binary(
        io_lib:format("%% coding: utf-8~n~0tp.~n", [Term])
    ).

hex_encode(Binary) ->
    unicode:characters_to_binary(
        [io_lib:format("~2.16.0b", [Byte]) || <<Byte>> <= Binary]
    ).

exit_with(Status, Format, Args) ->
    io:format(standard_error, Format, Args),
    halt(Status).
