#!/usr/bin/env escript
%%! -noshell
-mode(compile).

main(Args) ->
    case Args of
        [] ->
            print_usage(standard_error),
            halt(2);
        ["--help"] ->
            print_usage(standard_io),
            halt(0);
        ["-h"] ->
            print_usage(standard_io),
            halt(0);
        ["validate-root" | RestArgs] ->
            run_validate_root(RestArgs);
        ["get" | RestArgs] ->
            run_get(RestArgs);
        ["hash" | RestArgs] ->
            run_hash(RestArgs);
        [Command | _] ->
            exit_with(2, "manifest-tool command not implemented yet: ~ts~n", [Command])
    end.

print_usage(Device) ->
    io:format(
        Device,
        "Usage: manifest-tool <command> [options]~n~n"
        "Commands:~n"
        "  get            Read a top-level field from any Alloy manifest.~n"
        "  hash           Recompute and update the integrity hash of any Alloy manifest.~n"
        "  validate-root  Validate the manifest root tuple shape and manifest type.~n~n"
        "Examples:~n"
        "  manifest-tool get --manifest ALLOY_SDK_MANIFEST --field product~n"
        "  manifest-tool get --manifest ALLOY_FIRMWARE_MANIFEST --field capabilities --format erlang~n"
        "  manifest-tool hash --manifest ALLOY_PROJECT_MANIFEST~n"
        "  manifest-tool validate-root --manifest ALLOY_PROJECT_MANIFEST~n",
        []
    ).

run_validate_root(Args) ->
    case parse_validate_root_args(Args, undefined) of
        {ok, ManifestPath} ->
            case read_manifest_root(ManifestPath) of
                {ok, Tag, _Version, _Fields} ->
                    io:format("~ts~n", [atom_to_binary(Tag, utf8)]);
                {error, {structural, Reason}} ->
                    exit_with(2, "~ts~n", [format_structural_reason(Reason)]);
                {error, {parse, Reason}} ->
                    exit_with(3, "~ts~n", [format_parse_reason(ManifestPath, Reason)])
            end;
        {error, Reason} ->
            exit_with(2, "~ts~n", [Reason])
    end.

run_get(Args) ->
    case parse_get_args(Args, undefined, undefined, plain) of
        {ok, ManifestPath, FieldName, Format} ->
            case read_manifest_root(ManifestPath) of
                {ok, _Tag, _Version, Fields} ->
                    case lookup_manifest_field(FieldName, Fields) of
                        {ok, Value} ->
                            case render_field_output(Value, Format) of
                                {ok, Output} ->
                                    io:format("~ts~n", [Output]);
                                {error, Reason} ->
                                    exit_with(2, "~ts~n", [Reason])
                            end;
                        error ->
                            exit_with(1, "Field not found: ~ts~n", [FieldName])
                    end;
                {error, {structural, Reason}} ->
                    exit_with(2, "~ts~n", [format_structural_reason(Reason)]);
                {error, {parse, Reason}} ->
                    exit_with(3, "~ts~n", [format_parse_reason(ManifestPath, Reason)])
            end;
        {error, Reason} ->
            exit_with(2, "~ts~n", [Reason])
    end.

run_hash(Args) ->
    case parse_hash_args(Args, undefined) of
        {ok, ManifestPath} ->
            case read_manifest_root(ManifestPath) of
                {ok, Tag, Version, Fields} ->
                    StrippedFields = strip_integrity_fields(Fields),
                    Digest = manifest_digest({Tag, Version, StrippedFields}),
                    UpdatedFields = append_integrity_field(StrippedFields, Digest),
                    case write_manifest(ManifestPath, {Tag, Version, UpdatedFields}) of
                        ok ->
                            ok;
                        {error, Reason} ->
                            exit_with(2, "Failed to write manifest '~ts': ~tp~n", [ManifestPath, Reason])
                    end;
                {error, {structural, Reason}} ->
                    exit_with(2, "~ts~n", [format_structural_reason(Reason)]);
                {error, {parse, Reason}} ->
                    exit_with(3, "~ts~n", [format_parse_reason(ManifestPath, Reason)])
            end;
        {error, Reason} ->
            exit_with(2, "~ts~n", [Reason])
    end.

parse_validate_root_args([], ManifestPath) when ManifestPath =/= undefined ->
    {ok, ManifestPath};
parse_validate_root_args([], undefined) ->
    {error, <<"validate-root requires --manifest PATH">>};
parse_validate_root_args(["--manifest", ManifestPath | RestArgs], undefined) ->
    parse_validate_root_args(RestArgs, ManifestPath);
parse_validate_root_args(["--manifest" | _], _) ->
    {error, <<"validate-root requires --manifest PATH">>};
parse_validate_root_args([Unknown | _], _) ->
    {error, iolist_to_binary(io_lib:format("validate-root: unknown argument '~ts'", [Unknown]))}.

parse_get_args([], ManifestPath, FieldName, Format)
        when ManifestPath =/= undefined, FieldName =/= undefined ->
    {ok, ManifestPath, FieldName, Format};
parse_get_args([], _ManifestPath, _FieldName, _Format) ->
    {error, <<"get requires --manifest PATH and --field FIELD_NAME">>};
parse_get_args(["--manifest", ManifestPath | RestArgs], undefined, FieldName, Format) ->
    parse_get_args(RestArgs, ManifestPath, FieldName, Format);
parse_get_args(["--field", FieldName | RestArgs], ManifestPath, undefined, Format) ->
    parse_get_args(RestArgs, ManifestPath, FieldName, Format);
parse_get_args(["--format", "erlang" | RestArgs], ManifestPath, FieldName, _Format) ->
    parse_get_args(RestArgs, ManifestPath, FieldName, erlang);
parse_get_args(["--format", "plain" | RestArgs], ManifestPath, FieldName, _Format) ->
    parse_get_args(RestArgs, ManifestPath, FieldName, plain);
parse_get_args(["--manifest" | _], _ManifestPath, _FieldName, _Format) ->
    {error, <<"get requires --manifest PATH and --field FIELD_NAME">>};
parse_get_args(["--field" | _], _ManifestPath, _FieldName, _Format) ->
    {error, <<"get requires --manifest PATH and --field FIELD_NAME">>};
parse_get_args(["--format", Format | _], _ManifestPath, _FieldName, _CurrentFormat) ->
    {error, iolist_to_binary(io_lib:format("get: unsupported format '~ts'", [Format]))};
parse_get_args([Unknown | _], _ManifestPath, _FieldName, _Format) ->
    {error, iolist_to_binary(io_lib:format("get: unknown argument '~ts'", [Unknown]))}.

parse_hash_args([], ManifestPath) when ManifestPath =/= undefined ->
    {ok, ManifestPath};
parse_hash_args([], undefined) ->
    {error, <<"hash requires --manifest PATH">>};
parse_hash_args(["--manifest", ManifestPath | RestArgs], undefined) ->
    parse_hash_args(RestArgs, ManifestPath);
parse_hash_args(["--manifest" | _], _) ->
    {error, <<"hash requires --manifest PATH">>};
parse_hash_args([Unknown | _], _) ->
    {error, iolist_to_binary(io_lib:format("hash: unknown argument '~ts'", [Unknown]))}.

read_manifest_root(ManifestPath) ->
    case file:consult(ManifestPath) of
        {ok, [Term]} ->
            validate_manifest_root(Term);
        {ok, []} ->
            {error, {parse, empty_manifest}};
        {ok, _Terms} ->
            {error, {parse, multiple_terms}};
        {error, Reason} ->
            {error, {parse, Reason}}
    end.

validate_manifest_root({Tag, Version, Fields})
        when is_atom(Tag), is_binary(Version), is_list(Fields) ->
    case lists:member(Tag, [sdk_manifest, project_manifest, firmware_manifest]) of
        false ->
            {error, {structural, {unsupported_manifest_tag, Tag}}};
        true ->
            case lists:all(fun erlang:is_tuple/1, Fields) of
                true ->
                    {ok, Tag, Version, Fields};
                false ->
                    {error, {structural, manifest_fields_must_be_tuples}}
            end
    end;
validate_manifest_root({_Tag, Version, _Fields}) when not is_binary(Version) ->
    {error, {structural, manifest_version_must_be_binary}};
validate_manifest_root({_Tag, _Version, Fields}) when not is_list(Fields) ->
    {error, {structural, manifest_fields_must_be_list}};
validate_manifest_root(_Term) ->
    {error, {structural, invalid_manifest_root}}.

lookup_manifest_field(FieldName, Fields) ->
    FieldBinary = unicode:characters_to_binary(FieldName),
    lookup_manifest_field(FieldBinary, Fields, error).

lookup_manifest_field(_FieldName, [], Result) ->
    Result;
lookup_manifest_field(FieldName, [{Key, Value} | Rest], _Result)
        when is_atom(Key) ->
    case atom_to_binary(Key, utf8) of
        FieldName ->
            {ok, Value};
        _Other ->
            lookup_manifest_field(FieldName, Rest, error)
    end;
lookup_manifest_field(FieldName, [_Other | Rest], Result) ->
    lookup_manifest_field(FieldName, Rest, Result).

render_field_output(Value, erlang) ->
    {ok, iolist_to_binary(io_lib:format("~0tp", [Value]))};
render_field_output(Value, plain) when is_binary(Value) ->
    {ok, Value};
render_field_output(Value, plain) when is_atom(Value) ->
    {ok, atom_to_binary(Value, utf8)};
render_field_output(Value, plain) when is_integer(Value) ->
    {ok, integer_to_binary(Value)};
render_field_output(Value, plain) when is_list(Value) ->
    case lists:all(fun erlang:is_atom/1, Value) of
        true ->
            {ok,
                list_to_binary(
                    string:join(
                        [binary_to_list(atom_to_binary(Item, utf8)) || Item <- Value],
                        " "
                    )
                )};
        false ->
            {error, <<"Plain output does not support nested lists or proplists; use --format erlang">>}
    end;
render_field_output(_Value, plain) ->
    {error, <<"Plain output supports only binaries, atoms, integers, and lists of atoms; use --format erlang">>}.

format_structural_reason({unsupported_manifest_tag, Tag}) ->
    iolist_to_binary(
        io_lib:format(
            "Manifest root must use one of sdk_manifest, project_manifest, or firmware_manifest; got ~tp",
            [Tag]
        )
    );
format_structural_reason(manifest_version_must_be_binary) ->
    <<"Manifest root version must be a binary">>;
format_structural_reason(manifest_fields_must_be_list) ->
    <<"Manifest root fields must be a list">>;
format_structural_reason(manifest_fields_must_be_tuples) ->
    <<"Manifest root fields must contain only tuples">>;
format_structural_reason(invalid_manifest_root) ->
    <<"Manifest root must be {Tag, Version, Fields}">>.

format_parse_reason(ManifestPath, empty_manifest) ->
    iolist_to_binary(io_lib:format("Failed to parse manifest '~ts': file is empty", [ManifestPath]));
format_parse_reason(ManifestPath, multiple_terms) ->
    iolist_to_binary(
        io_lib:format("Failed to parse manifest '~ts': expected exactly one Erlang term", [ManifestPath])
    );
format_parse_reason(ManifestPath, Reason) ->
    iolist_to_binary(
        io_lib:format("Failed to parse manifest '~ts': ~tp", [ManifestPath, Reason])
    ).

strip_integrity_fields(Fields) ->
    [Field || {Key, _Value} = Field <- Fields, Key =/= integrity].

append_integrity_field(Fields, Digest) ->
    Fields ++
        [{integrity,
            [
                {digest_algorithm, sha256},
                {canonical_form, basic_term_canon},
                {digest, Digest}
            ]}].

manifest_digest(Term) ->
    hex_encode(crypto:hash(sha256, canonical_manifest_binary(Term))).

canonical_manifest_binary(Term) ->
    unicode:characters_to_binary(io_lib:format("~0tp.~n", [Term])).

write_manifest(ManifestPath, Term) ->
    file:write_file(ManifestPath, render_manifest_file(Term)).

render_manifest_file(Term) ->
    unicode:characters_to_binary(
        io_lib:format("%% coding: utf-8~n~0tp.~n", [Term])
    ).

hex_encode(Binary) ->
    unicode:characters_to_binary(
        [io_lib:format("~2.16.0b", [Byte]) || <<Byte>> <= Binary]
    ).

exit_with(Status, Format, Args) ->
    io:format(standard_error, Format, Args),
    halt(Status).
