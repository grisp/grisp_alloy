config BR2_PACKAGE_HOST_ALLOY_ERLANG_ARCH_SUPPORTS
	bool
	default y if BR2_HOSTARCH = "aarch64"
	default y if BR2_HOSTARCH = "x86_64"
	default y if BR2_HOSTARCH = "x86"

config BR2_PACKAGE_ALLOY_ERLANG_ARCH_SUPPORTS
	bool
	default y if BR2_i386 || BR2_x86_64 || BR2_powerpc || \
		BR2_sparc_v9 || BR2_arm || BR2_aarch64 || BR2_mipsel || \
		BR2_RISCV_64
	depends on BR2_PACKAGE_HOST_ALLOY_ERLANG_ARCH_SUPPORTS

comment "alloy_erlang needs a glibc or musl toolchain w/ dynamic library, threads, wchar"
	depends on BR2_USE_MMU
	depends on BR2_PACKAGE_ALLOY_ERLANG_ARCH_SUPPORTS
	depends on BR2_STATIC_LIBS || !BR2_TOOLCHAIN_HAS_THREADS || !BR2_USE_WCHAR || BR2_TOOLCHAIN_USES_UCLIBC

config BR2_PACKAGE_ALLOY_ERLANG
	bool "alloy_erlang"
	depends on BR2_USE_MMU
	depends on BR2_USE_WCHAR
	depends on !BR2_STATIC_LIBS
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_TOOLCHAIN_USES_UCLIBC
	depends on BR2_PACKAGE_ALLOY_ERLANG_ARCH_SUPPORTS
	select BR2_PACKAGE_ZLIB
	help
	  Alloy-managed Erlang/OTP package that installs host and target runtime
	  components for SDK project-build workflows.

if BR2_PACKAGE_ALLOY_ERLANG

config BR2_PACKAGE_ALLOY_ERLANG_GLOBAL_RUNTIME
	bool "install target Erlang runtime globally in rootfs"
	default n
	help
	  When enabled, target Erlang runtime files are installed in rootfs.
	  When disabled, target Erlang runtime remains available in staging for
	  project builds, but is not globally installed in rootfs.

config BR2_PACKAGE_ALLOY_ERLANG_XCOMP_CLOCK_GETTIME_CPU_TIME
	bool "force erl_xcomp_clock_gettime_cpu_time=yes for cross builds"
	default y
	help
	  When enabled, force Erlang configure to assume target support for
	  CLOCK_THREAD_CPUTIME_ID in cross builds.

config BR2_PACKAGE_ALLOY_ERLANG_POSIX_FALLOCATE_WORKS
	bool "force i_cv_posix_fallocate_works=yes for cross builds"
	default y
	help
	  When enabled, force Erlang configure to assume working
	  posix_fallocate() in cross builds.

endif
