%% coding: utf-8
{nugget, <<"1.0">>, [
    {id, feature_erlang},
    {category, feature},
    {name, <<"Erlang Runtime Feature">>},
    {description, <<"Provides Alloy-managed host/target Erlang runtime tooling and host rebar3 for project builds.">>},
    {version, <<"0.1.0">>},
    {config, [
        {erlang_global_runtime, <<"n">>}
    ]},
    {exports, [
        {host_erlang_root, {computed, <<"[[ALLOY_SDK_DIR]]/host/usr/lib/erlang">>}},
        {target_erlang_root, {computed, <<"[[ALLOY_SDK_DIR]]/staging/usr/lib/erlang">>}},
        {host_rebar3, {computed, <<"[[ALLOY_SDK_DIR]]/host/bin/rebar3">>}},
        {otp_version, {exec, <<"scripts/exports.sh">>}}
    ]},
    {buildroot, [
        {packages, <<"package">>},
        {defconfig_fragment, <<"buildroot.defconfig.fragment">>}
    ]}
]}.
