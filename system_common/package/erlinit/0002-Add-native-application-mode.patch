+/* Native programs receive SIGTERM, unlike BEAM which requests shutdown itself. */
+static void wait_for_native_shutdown(pid_t pid, struct erlinit_exit_info *exit_info)
+{
+    sigset_t mask;
+    sigemptyset(&mask);
+    sigaddset(&mask, SIGCHLD);
+    clock_gettime(CLOCK_MONOTONIC, &exit_info->shutdown_start);
+    exit_info->graceful_shutdown_ok = 0;
+    if (kill(pid, SIGTERM) < 0 && errno != ESRCH)
+        elog(ELOG_WARNING, "Cannot signal native application: %s", strerror(errno));
+
+    int milliseconds = options.graceful_shutdown_timeout_ms;
+    if (milliseconds <= 0)
+        milliseconds = 1;
+    struct timespec deadline = exit_info->shutdown_start;
+    deadline.tv_sec += milliseconds / 1000;
+    deadline.tv_nsec += (milliseconds % 1000) * 1000000L;
+    if (deadline.tv_nsec >= 1000000000L) {
+        deadline.tv_sec++;
+        deadline.tv_nsec -= 1000000000L;
+    }
+
+    for (;;) {
+        /* Drain exits before waiting: SIGCHLD can coalesce for several children. */
+        pid_t child_pid;
+        while ((child_pid = waitpid(-1, &exit_info->wait_status, WNOHANG)) > 0) {
+            if (child_pid == pid) {
+                exit_info->graceful_shutdown_ok = 1;
+                goto complete;
+            }
+        }
+        if (child_pid < 0 && errno != EINTR)
+            break;
+        struct timespec now, remaining;
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        remaining.tv_sec = deadline.tv_sec - now.tv_sec;
+        remaining.tv_nsec = deadline.tv_nsec - now.tv_nsec;
+        if (remaining.tv_nsec < 0) {
+            remaining.tv_sec--;
+            remaining.tv_nsec += 1000000000L;
+        }
+        if (remaining.tv_sec < 0)
+            break;
+        int rc = sigtimedwait(&mask, NULL, &remaining);
+        if (rc < 0 && errno != EINTR)
+            break;
+    }
+    if (!exit_info->graceful_shutdown_ok)
+        elog(ELOG_WARNING, "Native application shutdown timed out; continuing system shutdown");
+complete:
+    clock_gettime(CLOCK_MONOTONIC, &exit_info->shutdown_complete);
+}
+
 static void wait_for_graceful_shutdown(pid_t pid, struct erlinit_exit_info *exit_info)
 {
+    if (options.native_exec) {
+        wait_for_native_shutdown(pid, exit_info);
+        return;
+    }
